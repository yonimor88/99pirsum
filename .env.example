# Contact form email delivery (optional).
# Without RESEND_API_KEY the form still works: visitors are offered to send
# their details over WhatsApp instead.
RESEND_API_KEY=
# Where leads are sent (defaults to 99Pirsum@gmail.com)
CONTACT_TO_EMAIL=
# Sender address — must be on a domain verified in Resend, e.g. "99 פרסום <site@99pirsum.com>"
CONTACT_FROM_EMAIL=
